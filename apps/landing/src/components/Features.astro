---
import type { Feature } from "../data/features";
import LightboxImage from "./lightbox/LightboxImage.astro";

interface Props {
  items: Feature[];
  layout?: "grid" | "alternating";
  title?: string;
  subtitle?: string;
}

const {
  items,
  layout = "grid",
  title = "Todo tu mercado, en un solo lugar",
  subtitle = "",
} = Astro.props;
---
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  {title && (
    <div class="max-w-3xl">
      <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl" data-reveal>{title}</h2>
      {subtitle && <p class="mt-3 text-muted" data-reveal>{subtitle}</p>}
    </div>
  )}

  {layout === "grid" && (
    <div class="mt-12 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
      {items.map((f, i) => (
        <article class={i === 0 ? "md:col-span-2" : ""} data-reveal>
          <div class="aspect-[16/10] overflow-hidden rounded-2xl border border-border bg-surface shadow-[0_12px_40px_-20px_rgba(6,64,40,0.15)]">
            <LightboxImage
              src={f.image}
              alt={f.alt}
              group="features"
              caption={f.title}
              label="Ampliar captura"
              class="h-full w-full"
            />
          </div>
          <h3 class="mt-5 text-xl font-semibold tracking-tight">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{f.description}</p>
        </article>
      ))}
    </div>
  )}

  {layout === "alternating" && (
    <div class="mt-12 space-y-16">
      {items.map((f, i) => (
        <article
          class={`flex flex-col items-center gap-8 md:flex-row ${i % 2 === 1 ? "md:flex-row-reverse" : ""}`}
          data-reveal
        >
          <div class="w-full overflow-hidden rounded-2xl border border-border bg-surface shadow-[0_12px_40px_-20px_rgba(6,64,40,0.15)] md:w-1/2">
            <LightboxImage
              src={f.image}
              alt={f.alt}
              group="features"
              caption={f.title}
              label="Ver en pantalla completa"
              fit="full"
            />
          </div>
          <div class="w-full md:w-1/2">
            <h3 class="text-2xl font-semibold tracking-tight">{f.title}</h3>
            <p class="mt-3 text-muted">{f.description}</p>
            <ul class="mt-5 space-y-2 text-sm">
              {f.bullets.map((b) => (
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-brand" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
                      <path d="M3 8.5l3.5 3.5L13 4.5" />
                    </svg>
                  </span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  )}
</section>
