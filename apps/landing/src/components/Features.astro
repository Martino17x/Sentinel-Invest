---
import type { Feature } from "../data/features";

interface Props {
  items: Feature[];
  layout?: "grid" | "alternating";
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}

const {
  items,
  layout = "grid",
  eyebrow = "Funcionalidades",
  title = "Todo tu mercado, en un solo lugar",
  subtitle = "",
} = Astro.props;
---
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
  {title && (
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-brand" data-reveal>{eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl" data-reveal>{title}</h2>
      {subtitle && <p class="mt-3 text-muted" data-reveal>{subtitle}</p>}
    </div>
  )}

  {layout === "grid" && (
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {items.map((f) => (
        <article class="overflow-hidden rounded-2xl border border-border bg-background" data-reveal>
          <img
            src={f.image}
            alt={f.alt}
            class="aspect-[16/9] w-full border-b border-border object-cover object-top"
            loading="lazy"
          />
          <div class="p-6">
            <h3 class="text-lg font-semibold">{f.title}</h3>
            <p class="mt-2 text-sm text-muted">{f.description}</p>
            <ul class="mt-4 space-y-1.5 text-sm">
              {f.bullets.map((b) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  )}

  {layout === "alternating" && (
    <div class="mt-4 space-y-16">
      {items.map((f, i) => (
        <article
          class={`flex flex-col items-center gap-8 md:flex-row ${i % 2 === 1 ? "md:flex-row-reverse" : ""}`}
          data-reveal
        >
          <img
            src={f.image}
            alt={f.alt}
            class="w-full rounded-2xl border border-border object-cover object-top shadow-sm md:w-1/2"
            loading="lazy"
          />
          <div class="w-full md:w-1/2">
            <h3 class="text-2xl font-semibold tracking-tight">{f.title}</h3>
            <p class="mt-3 text-muted">{f.description}</p>
            <ul class="mt-5 space-y-2 text-sm">
              {f.bullets.map((b) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  )}
</section>
