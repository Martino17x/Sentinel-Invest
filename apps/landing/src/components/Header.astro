---
import { SITE } from "../data/site";

const nav = [
  { label: "Funcionalidades", href: "/funcionalidades" },
  { label: "Pantallas", href: "/pantallas" },
  { label: "Agente", href: "/agente" },
  { label: "Seguridad", href: "/seguridad" },
  { label: "Precios", href: "/precios" },
];
---
<header class="sticky top-0 z-40 border-b border-border/70 bg-background/85 backdrop-blur" transition:persist>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight" aria-label="Sentinel — inicio">
      <img src="/favicon.svg" alt="" width="26" height="26" class="rounded-md" />
      <span>{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
      {nav.map((item) => (
        <a
          href={item.href}
          class="rounded-md px-3 py-2 text-sm text-muted transition-colors hover:bg-surface hover:text-foreground"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={SITE.loginUrl}
        class="hidden text-sm font-medium text-muted transition-colors hover:text-foreground sm:block"
      >
        Ingresar
      </a>
      <a
        href={SITE.registerUrl}
        class="rounded-lg bg-primary px-3.5 py-2 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
      >
        Crear cuenta
      </a>
      <details class="group relative md:hidden">
        <summary
          class="flex cursor-pointer list-none items-center gap-1 rounded-md px-2 py-2 text-sm text-muted hover:bg-surface"
          aria-label="Abrir menú"
        >
          Menú
        </summary>
        <div class="absolute right-0 mt-2 w-52 rounded-xl border border-border bg-background p-2 shadow-lg">
          {nav.map((item) => (
            <a href={item.href} class="block rounded-lg px-3 py-2 text-sm text-foreground hover:bg-surface">
              {item.label}
            </a>
          ))}
          <a href={SITE.loginUrl} class="mt-1 block rounded-lg px-3 py-2 text-sm text-muted hover:bg-surface">
            Ingresar
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
