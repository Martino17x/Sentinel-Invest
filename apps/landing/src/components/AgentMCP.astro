---
import { agents } from "../data/agents";
import LightboxImage from "./lightbox/LightboxImage.astro";

const solutions = [
  "Consultar cotizaciones en tiempo real",
  "Analizar instrumentos y acciones",
  "Resumir tu portafolio",
  "Ver el dólar del día",
  "Generar reportes de tu cartera",
];
---
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl" data-reveal>Tu agente lee tu cartera</h2>
    <p class="mt-3 text-muted" data-reveal>
      Conectá tu agente de IA favorito vía MCP y pedile que resuma tu cartera, cotizaciones o el dólar en segundos.
    </p>
  </div>

  <div class="mt-10 overflow-hidden rounded-2xl border border-border bg-surface shadow-[0_12px_40px_-20px_rgba(6,64,40,0.15)]" data-reveal>
    <LightboxImage
      src="/screens/desktop/agent-connect.png"
      alt="Configuración del agente de IA vía MCP"
      group="agentmcp"
      label="Ver en pantalla completa"
      fit="full"
    />
  </div>

  <div class="mt-12 grid gap-6 md:grid-cols-2">
    <div class="rounded-2xl border border-border bg-background p-6" data-reveal>
      <h3 class="text-lg font-semibold">Agentes soportados</h3>
      <ul class="mt-4 space-y-3 text-sm">
        {agents.map((a) => (
          <li class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <span class="font-medium text-foreground">{a.name}</span>
            <span class="text-muted">— {a.description}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-2xl border border-border bg-background p-6" data-reveal>
      <h3 class="text-lg font-semibold">Qué podés hacer</h3>
      <ul class="mt-4 space-y-3 text-sm">
        {solutions.map((s) => (
          <li class="flex items-start gap-2">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-brand" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
                <path d="M3 8.5l3.5 3.5L13 4.5" />
              </svg>
            </span>
            <span>{s}</span>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-xs text-muted">Solo lectura: ninguna herramienta puede operar.</p>
    </div>
  </div>
</section>
