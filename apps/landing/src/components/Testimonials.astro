---
import { testimonials } from "../data/social";
---
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl" data-reveal>Lo que dicen quienes lo usan</h2>
    <p class="mt-3 text-muted" data-reveal>Perfiles de ejemplo — cuando haya usuarios reales, los actualizamos.</p>
  </div>
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {testimonials.map((t) => (
      <figure class="rounded-2xl border border-border bg-background p-6" data-reveal>
        <blockquote class="text-[15px] leading-relaxed">“{t.quote}”</blockquote>
        <figcaption class="mt-4 flex items-center gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-foreground">
            {t.name.charAt(0)}
          </span>
          <div>
            <div class="text-sm font-medium">{t.name}</div>
            <div class="text-xs text-muted">{t.role}</div>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
