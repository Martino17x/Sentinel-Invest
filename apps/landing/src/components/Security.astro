---
import LightboxImage from "./lightbox/LightboxImage.astro";

const items = [
  { title: "Solo lectura", desc: "Sentinel nunca ejecuta órdenes de compra o venta. Mirás tus datos, no tocamos tu dinero." },
  { title: "Cifrado AES-256", desc: "Tus credenciales de IOL se guardan cifradas. Al desconectar, se eliminan de inmediato." },
  { title: "Vos controlás", desc: "Desconectá tu cuenta cuando quieras. Sin permanencia de datos sensibles." },
];
---
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="grid items-center gap-10 md:grid-cols-2">
    <div>
      <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl" data-reveal>Tu dinero, siempre tuyo</h2>
      <div class="mt-8 space-y-6">
        {items.map((it) => (
          <div class="flex gap-4" data-reveal>
            <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center text-brand" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                <path d="M3 8.5l3.5 3.5L13 4.5" />
              </svg>
            </span>
            <div>
              <h3 class="font-semibold">{it.title}</h3>
              <p class="mt-1 text-sm text-muted">{it.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="overflow-hidden rounded-2xl border border-border bg-surface shadow-[0_12px_40px_-20px_rgba(6,64,40,0.15)]" data-reveal>
      <LightboxImage
        src="/screens/desktop/connect.png"
        alt="Pantalla de conexión de cuenta IOL con el estado activo"
        group="security"
        label="Ver en pantalla completa"
        fit="full"
      />
    </div>
  </div>
</section>
