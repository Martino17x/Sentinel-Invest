---
import LightboxImage from "./lightbox/LightboxImage.astro";

const slides = [
  { src: "/screens/desktop/portfolio.png", alt: "Panel de portafolio: total valorizado, KPIs y evolución a 90 días" },
  { src: "/screens/desktop/inicio.png", alt: "Inicio con el total valorizado y el dólar del día" },
  { src: "/screens/desktop/analysis.png", alt: "Análisis técnico con señal compuesta" },
  { src: "/screens/desktop/quotes.png", alt: "Cotizaciones en tiempo real" },
  { src: "/screens/desktop/reports.png", alt: "Reportes mensuales con TWR y comparativa Merval" },
  { src: "/screens/desktop/agent-connect.png", alt: "Conexión de agentes de IA vía MCP" },
];
---
<div class="hero-gallery grid gap-3 lg:grid-cols-[minmax(0,1fr)_9.5rem] lg:gap-4" data-hero-gallery>
  <div class="relative aspect-[16/10] overflow-hidden rounded-[1.25rem] border border-border/70 bg-white">
    <LightboxImage
      src={slides[0].src}
      alt={slides[0].alt}
      group="hero"
      label="Ver en pantalla completa"
      loading="eager"
      class="h-full w-full"
    />
  </div>

  <div class="flex gap-3 overflow-x-auto pb-1 lg:flex-col lg:overflow-visible lg:pb-0" data-hero-thumbs>
    {slides.map((s, i) => (
      <button
        type="button"
        class="hero-gallery__thumb shrink-0"
        data-hero-thumb={String(i)}
        data-src={s.src}
        data-alt={s.alt}
        aria-label={`Ver captura: ${s.alt}`}
        aria-pressed={i === 0}
      >
        <img
          src={s.src}
          alt=""
          class="aspect-[16/10] w-24 rounded-lg object-cover object-top lg:w-full"
          loading="lazy"
        />
      </button>
    ))}
  </div>
</div>

<style>
  .hero-gallery__thumb {
    opacity: 0.65;
    transition: opacity 0.2s ease, box-shadow 0.2s ease;
  }
  .hero-gallery__thumb:hover,
  .hero-gallery__thumb:focus-visible {
    opacity: 1;
  }
  .hero-gallery__thumb.is-active {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--color-brand);
  }
</style>

<script>
  function initHeroGallery(): void {
    const root = document.querySelector<HTMLElement>("[data-hero-gallery]");
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const big = root.querySelector<HTMLElement>('[data-lightbox="hero"]');
    const bigImg = big?.querySelector("img");
    const thumbs = Array.from(root.querySelectorAll<HTMLElement>("[data-hero-thumb]"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const SLIDE_MS = 5000;

    let index = 0;
    let timer = 0;

    function show(i: number): void {
      index = (i + thumbs.length) % thumbs.length;
      const t = thumbs[index];
      const src = t.dataset.src ?? "";
      const alt = t.dataset.alt ?? "";
      if (bigImg) {
        bigImg.src = src;
        bigImg.alt = alt;
      }
      if (big) {
        big.dataset.lightboxSrc = src;
        big.dataset.lightboxAlt = alt;
        big.dataset.lightboxCaption = alt;
      }
      thumbs.forEach((th, j) => {
        const selected = j === index;
        th.setAttribute("aria-pressed", String(selected));
        th.classList.toggle("is-active", selected);
      });
    }

    function start(): void {
      if (reduce.matches) return;
      stop();
      timer = window.setInterval(() => show(index + 1), SLIDE_MS);
    }
    function stop(): void {
      if (timer) {
        window.clearInterval(timer);
        timer = 0;
      }
    }

    thumbs.forEach((th, i) => {
      th.addEventListener("click", () => {
        show(i);
        start();
      });
    });
    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", () => {
      if (!root.contains(document.activeElement)) start();
    });

    show(0);
    start();
  }

  document.addEventListener("astro:page-load", () => initHeroGallery());
</script>
