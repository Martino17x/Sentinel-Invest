---
import { plans } from "../data/pricing";
---
<section id="precios" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl" data-reveal>Simple y transparente</h2>
    <p class="mt-3 text-muted" data-reveal>Empezá gratis. El plan Pro llega pronto.</p>
  </div>
  <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
    {plans.map((plan) => (
      <article
        class={`relative flex flex-col rounded-2xl border p-8 ${
          plan.highlighted ? "border-brand bg-brand-dark text-white" : "border-border bg-background"
        }`}
        data-reveal
      >
        {plan.badge && (
          <span
            class={`absolute -top-3 left-8 rounded-full px-3 py-1 text-xs font-semibold ${
              plan.highlighted ? "bg-white text-brand-dark" : "bg-primary text-primary-foreground"
            }`}
          >
            {plan.badge}
          </span>
        )}
        <h3 class="text-lg font-semibold">{plan.name}</h3>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="text-4xl font-semibold tracking-tight">{plan.price}</span>
          {plan.period && <span class={plan.highlighted ? "text-white/70" : "text-muted"}>{plan.period}</span>}
        </div>
        <p class={`mt-3 text-sm ${plan.highlighted ? "text-white/85" : "text-muted"}`}>{plan.description}</p>
        <ul class={`mt-6 space-y-2.5 text-sm ${plan.highlighted ? "text-white/90" : ""}`}>
          {plan.features.map((f) => (
            <li class="flex items-start gap-2">
              <span class={`mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center ${plan.highlighted ? "text-white" : "text-brand"}`} aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
                  <path d="M3 8.5l3.5 3.5L13 4.5" />
                </svg>
              </span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        {plan.form ? (
          <div class="mt-8" data-waitlist-form>
            <form class="flex flex-col gap-2 sm:flex-row" novalidate data-waitlist-form-element>
              <label class="sr-only" for="waitlist-email">Email</label>
              <input
                id="waitlist-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="tu@email.com"
                class="w-full min-w-0 flex-1 rounded-lg border border-white/30 bg-white px-4 py-2.5 text-sm text-foreground placeholder:text-muted transition focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/70"
                data-waitlist-input
              />
              <button
                type="submit"
                class="shrink-0 rounded-lg bg-white px-5 py-2.5 text-center text-sm font-medium text-brand-dark transition hover:bg-white/90 hover:shadow-lg active:scale-[0.98]"
              >
                Avisame
              </button>
            </form>
            <p
              class="mt-3 hidden items-center gap-2 text-sm font-medium text-white"
              role="status"
              aria-live="polite"
              tabindex="-1"
              data-waitlist-success
            >
              <span aria-hidden="true">✓</span>
              ¡Listo! Te avisamos cuando salga el plan Pro.
            </p>
          </div>
        ) : (
          <a
            href={plan.href}
            class={`mt-8 rounded-lg px-5 py-2.5 text-center text-sm font-medium transition ${
              plan.highlighted
                ? "bg-white text-brand-dark hover:bg-white/90 hover:shadow-lg"
                : "bg-primary text-primary-foreground hover:brightness-110 active:scale-[0.98]"
            }`}
          >
            {plan.cta}
          </a>
        )}
      </article>
    ))}
  </div>
</section>

<script>
  const STORAGE_KEY = "sentinel_waitlist_email";
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function readStoredEmail(): string | null {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  }

  function storeEmail(email: string): void {
    try {
      localStorage.setItem(STORAGE_KEY, email);
    } catch {
      // Almacenamiento no disponible: el form es un placeholder, el éxito es solo visual.
    }
  }

  function initWaitlistForms(): void {
    document.querySelectorAll<HTMLElement>("[data-waitlist-form]").forEach((root) => {
      if (root.dataset.bound === "true") return;
      root.dataset.bound = "true";

      const form = root.querySelector<HTMLFormElement>("[data-waitlist-form-element]");
      const input = root.querySelector<HTMLInputElement>("[data-waitlist-input]");
      const success = root.querySelector<HTMLElement>("[data-waitlist-success]");
      if (!form || !input || !success) return;

      const showSuccess = (focus: boolean): void => {
        form.classList.add("hidden");
        form.classList.remove("flex");
        success.classList.remove("hidden");
        success.classList.add("flex");
        if (focus) success.focus();
      };

      // Ya anotado: mostrar el mensaje de éxito directamente, sin robar el foco en la carga.
      if (readStoredEmail()) {
        showSuccess(false);
        return;
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const email = input.value.trim();
        if (!EMAIL_RE.test(email)) {
          input.setCustomValidity("Ingresá un email válido.");
          input.reportValidity();
          input.focus();
          return;
        }
        input.setCustomValidity("");
        storeEmail(email);
        showSuccess(true);
      });

      input.addEventListener("input", () => input.setCustomValidity(""));
    });
  }

  document.addEventListener("astro:page-load", () => initWaitlistForms());
</script>
