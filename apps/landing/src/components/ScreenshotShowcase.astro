---
const desktop = [
  "/screens/desktop/inicio.png",
  "/screens/desktop/portfolio.png",
  "/screens/desktop/operations.png",
  "/screens/desktop/quotes.png",
  "/screens/desktop/quote-detail.png",
  "/screens/desktop/analysis.png",
  "/screens/desktop/reports.png",
  "/screens/desktop/agent-connect.png",
  "/screens/desktop/connect.png",
  "/screens/desktop/profile.png",
  "/screens/desktop/login.png",
  "/screens/desktop/register.png",
];

const mobile = [
  "/screens/mobile/login.png",
  "/screens/mobile/inicio.png",
  "/screens/mobile/portfolio.png",
  "/screens/mobile/operations.png",
  "/screens/mobile/quotes.png",
  "/screens/mobile/quote-detail.png",
  "/screens/mobile/reports.png",
  "/screens/mobile/agent-connect.png",
];
---
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-brand" data-reveal>Pantallas</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl" data-reveal>Así se ve Sentinel</h2>
    <p class="mt-3 text-muted" data-reveal>Capturas reales de la app con datos de ejemplo.</p>
  </div>

  <div class="mx-auto mt-10 max-w-md">
    <input id="view-desktop" type="radio" name="view" value="desktop" class="peer/view-desktop sr-only" checked />
    <input id="view-mobile" type="radio" name="view" value="mobile" class="peer/view-mobile sr-only" />
    <div class="flex justify-center gap-2 rounded-full border border-border bg-surface p-1">
      <label for="view-desktop" class="cursor-pointer rounded-full px-5 py-2 text-sm font-medium text-muted transition-colors peer-checked/view-desktop:bg-primary peer-checked/view-desktop:text-primary-foreground">
        Desktop
      </label>
      <label for="view-mobile" class="cursor-pointer rounded-full px-5 py-2 text-sm font-medium text-muted transition-colors peer-checked/view-mobile:bg-primary peer-checked/view-mobile:text-primary-foreground">
        Mobile
      </label>
    </div>

    <div class="hidden pt-10 peer-checked/view-desktop:block">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {desktop.map((src) => (
          <img src={src} alt="" class="w-full rounded-xl border border-border object-cover object-top shadow-sm" loading="lazy" />
        ))}
      </div>
    </div>
    <div class="hidden pt-10 peer-checked/view-mobile:block">
      <div class="grid grid-cols-2 gap-5 sm:grid-cols-3">
        {mobile.map((src) => (
          <img src={src} alt="" class="w-full rounded-xl border border-border object-cover object-top shadow-sm" loading="lazy" />
        ))}
      </div>
    </div>
  </div>
</section>
