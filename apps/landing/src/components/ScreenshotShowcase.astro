---
import LightboxImage from "./lightbox/LightboxImage.astro";

const desktop = [
  { src: "/screens/desktop/inicio.png", alt: "Inicio de Sentinel con el total valorizado y el dólar del día" },
  { src: "/screens/desktop/portfolio.png", alt: "Panel de portafolio con KPIs y evolución a 90 días" },
  { src: "/screens/desktop/operations.png", alt: "Historial de operaciones" },
  { src: "/screens/desktop/quotes.png", alt: "Cotizaciones en tiempo real de CEDEARs" },
  { src: "/screens/desktop/quote-detail.png", alt: "Detalle de cotización con gráfico" },
  { src: "/screens/desktop/analysis.png", alt: "Análisis técnico con señal compuesta" },
  { src: "/screens/desktop/reports.png", alt: "Reportes mensuales con TWR y comparativa Merval" },
  { src: "/screens/desktop/agent-connect.png", alt: "Conexión de agentes de IA vía MCP" },
  { src: "/screens/desktop/connect.png", alt: "Conexión de cuenta IOL" },
  { src: "/screens/desktop/profile.png", alt: "Perfil con API keys" },
  { src: "/screens/desktop/login.png", alt: "Pantalla de ingreso" },
  { src: "/screens/desktop/register.png", alt: "Pantalla de registro" },
];

const mobile = [
  { src: "/screens/mobile/login.png", alt: "Ingreso móvil" },
  { src: "/screens/mobile/inicio.png", alt: "Inicio móvil con el total valorizado" },
  { src: "/screens/mobile/portfolio.png", alt: "Portafolio móvil" },
  { src: "/screens/mobile/operations.png", alt: "Operaciones móviles" },
  { src: "/screens/mobile/quotes.png", alt: "Cotizaciones móviles" },
  { src: "/screens/mobile/quote-detail.png", alt: "Detalle de cotización móvil" },
  { src: "/screens/mobile/reports.png", alt: "Reportes móviles" },
  { src: "/screens/mobile/agent-connect.png", alt: "Agente IA móvil" },
];
---
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl" data-reveal>Así se ve Sentinel</h2>
    <p class="mt-3 text-muted" data-reveal>Capturas reales de la app con datos de ejemplo. Tocá para verlas en pantalla completa.</p>
  </div>

  <div class="mx-auto mt-10 max-w-md">
    <input id="view-desktop" type="radio" name="view" value="desktop" class="peer/view-desktop sr-only" checked />
    <input id="view-mobile" type="radio" name="view" value="mobile" class="peer/view-mobile sr-only" />
    <div class="flex justify-center gap-2 rounded-full border border-border bg-surface p-1">
      <label for="view-desktop" class="cursor-pointer rounded-full px-5 py-2 text-sm font-medium text-muted transition-colors peer-checked/view-desktop:bg-primary peer-checked/view-desktop:text-primary-foreground">
        Desktop
      </label>
      <label for="view-mobile" class="cursor-pointer rounded-full px-5 py-2 text-sm font-medium text-muted transition-colors peer-checked/view-mobile:bg-primary peer-checked/view-mobile:text-primary-foreground">
        Mobile
      </label>
    </div>

    <div class="hidden pt-10 peer-checked/view-desktop:block">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {desktop.map((s) => (
          <LightboxImage
            src={s.src}
            alt={s.alt}
            group="screens-desktop"
            label="Ampliar captura"
            class="aspect-[16/10] h-full w-full"
          />
        ))}
      </div>
    </div>
    <div class="hidden pt-10 peer-checked/view-mobile:block">
      <div class="grid grid-cols-2 gap-5 sm:grid-cols-3">
        {mobile.map((s) => (
          <LightboxImage
            src={s.src}
            alt={s.alt}
            group="screens-mobile"
            label="Ampliar captura"
            class="aspect-[9/16] h-full w-full"
          />
        ))}
      </div>
    </div>
  </div>
</section>
