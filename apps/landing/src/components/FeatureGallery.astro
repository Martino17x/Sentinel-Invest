---
import type { Feature } from "../data/features";
import LightboxImage from "./lightbox/LightboxImage.astro";

interface Props {
  items: Feature[];
  title?: string;
  subtitle?: string;
}

const { items, title = "Todo tu mercado, en un solo lugar", subtitle = "" } = Astro.props;
---
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="max-w-3xl">
    <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl" data-reveal>{title}</h2>
    {subtitle && <p class="mt-3 text-muted" data-reveal>{subtitle}</p>}
  </div>

  <div
    class="mt-10 overflow-hidden rounded-3xl border border-border bg-background shadow-[0_12px_40px_-20px_rgba(6,64,40,0.15)]"
    data-reveal
    data-feature-gallery
  >
    <div class="grid lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="relative aspect-[16/10] bg-surface">
        <LightboxImage
          src={items[0]?.image ?? ""}
          alt={items[0]?.alt ?? "Captura de Sentinel"}
          group="features"
          label="Ver en pantalla completa"
          class="h-full w-full"
          loading="eager"
        />
      </div>

      <div
        class="flex flex-col divide-y divide-border border-t border-border lg:border-l lg:border-t-0"
        data-feature-rows
      >
        {items.map((f, i) => (
          <button
            type="button"
            class="feature-row flex items-center gap-4 px-5 py-4 text-left"
            data-feature-row={String(i)}
            data-src={f.image}
            data-alt={f.alt}
            aria-pressed={i === 0}
          >
            <img src={f.image} alt="" class="h-14 w-20 shrink-0 rounded-lg object-cover object-top" loading="lazy" />
            <span class="min-w-0 flex-1">
              <span class="block font-semibold">{f.title}</span>
              <span class="mt-0.5 block text-sm leading-snug text-muted">{f.description}</span>
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .feature-row {
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }
  .feature-row:hover,
  .feature-row:focus-visible {
    background: var(--color-surface);
  }
  .feature-row.is-active {
    background: color-mix(in oklab, var(--color-brand) 6%, transparent);
    box-shadow: inset 3px 0 0 var(--color-brand);
  }
</style>

<script>
  function initFeatureGallery(): void {
    const root = document.querySelector<HTMLElement>("[data-feature-gallery]");
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const big = root.querySelector<HTMLElement>('[data-lightbox="features"]');
    const bigImg = big?.querySelector("img");
    const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-feature-row]"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const SLIDE_MS = 5000;

    let index = 0;
    let timer = 0;

    function show(i: number): void {
      index = (i + rows.length) % rows.length;
      const r = rows[index];
      const src = r.dataset.src ?? "";
      const alt = r.dataset.alt ?? "";
      if (bigImg) {
        bigImg.src = src;
        bigImg.alt = alt;
      }
      if (big) {
        big.dataset.lightboxSrc = src;
        big.dataset.lightboxAlt = alt;
        big.dataset.lightboxCaption = alt;
      }
      rows.forEach((row, j) => {
        const selected = j === index;
        row.setAttribute("aria-pressed", String(selected));
        row.classList.toggle("is-active", selected);
      });
    }

    function start(): void {
      if (reduce.matches) return;
      stop();
      timer = window.setInterval(() => show(index + 1), SLIDE_MS);
    }
    function stop(): void {
      if (timer) {
        window.clearInterval(timer);
        timer = 0;
      }
    }

    rows.forEach((row, i) => {
      row.addEventListener("click", () => {
        show(i);
        start();
      });
    });
    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", () => {
      if (!root.contains(document.activeElement)) start();
    });

    show(0);
    start();
  }

  document.addEventListener("astro:page-load", () => initFeatureGallery());
</script>
