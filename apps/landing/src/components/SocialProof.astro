---
import { metrics } from "../data/social";
---
<section class="border-y border-border bg-surface/60">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <dl class="grid grid-cols-2 gap-x-8 gap-y-10 lg:grid-cols-4 lg:divide-x lg:divide-border">
      {metrics.map((m) => (
        <div class="lg:px-8 lg:first:pl-0">
          <dd class="text-3xl font-semibold tracking-tight sm:text-4xl">{m.value}</dd>
          <dt class="mt-2 text-sm text-muted">{m.label}</dt>
        </div>
      ))}
    </dl>
  </div>
</section>
