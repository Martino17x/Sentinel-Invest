---
import { ViewTransitions } from "astro:transitions";

interface Props {
  title?: string;
}

const { title = "Sentinel Invest" } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Sentinel Invest — control de inversiones en InvertirOnline." />
    <ViewTransitions />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <slot />
  </body>
</html>
