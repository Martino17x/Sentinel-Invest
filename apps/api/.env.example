# ============================================================
# Sentinel API — .env.example
# Copiar a .env y completar los secretos (nunca commitear .env)
# ============================================================

# Postgres (Docker: docker compose up -d db)
DATABASE_URL=postgresql://invertir:invertir_dev_password@localhost:5433/invertir
PORT=3001

# Auth
JWT_SECRET=cambiar_este_secreto_en_produccion
JWT_REFRESH_SECRET=cambiar_este_refresh_secreto_en_produccion
CLIENT_ORIGIN=http://localhost:5173,http://192.168.1.3:5173 # LAN: agregar IP del host si probas desde el celu (o usa regex automatico en src/index.ts)

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Cifrado credenciales IOL (AES-256-GCM, 32 bytes hex)
ENCRYPTION_KEY=xxx

# IOL — credenciales de prueba (solo dev)
IOL_TEST_USERNAME=
IOL_TEST_PASSWORD=
IOL_TEST_ACCOUNT=
IOL_PROVIDER=api
IOL_TRADING_ENABLED=true
QUOTE_PROVIDER=auto

# AI Agent
AGENT_ENABLED=true
OPENROUTER_API_KEY=sk-or-v1-xxx
AGENT_MODEL=deepseek/deepseek-v4-flash

# ============================================================
# Content Providers — Noticias (Track A) — Batch 1
# ============================================================
# GNews (https://gnews.io) — 100 req/día free, lang=es country=ar
# Sin key → cascade salta GNews y cae a degraded tradingview (warn-only)
GNEWS_API_KEY=
# Finnhub (https://finnhub.io) — 60 req/min free, header X-Finnhub-Token
# Solo se usa si isCedear || market != bcba. Sin key → se salta
FINNHUB_API_KEY=
# Flag de rollback sin deploy: gnews | finnhub | tradingview (default gnews)
# tradingview restaura title-only (degraded:true) y evita consumo de cuotas
NEWS_PROVIDER=gnews
# Brandfetch mirror server-side (opcional, el CDN se usa solo en frontend)
# Si se setea, brand-map API puede construir URL con ?c=
BRANDFETCH_CLIENT_ID=
