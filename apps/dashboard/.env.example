# Dashboard — .env.example
# Copiar a .env y completar

# Origen del backend Express - DEPRECADO para Google OAuth
# GoogleButton ahora usa ruta relativa /api/auth/google via proxy (LAN-friendly).
# VITE_SERVER_ORIGIN solo si necesitas fetch directo fuera del proxy.
# VITE_SERVER_ORIGIN=http://localhost:3001

# Brandfetch CDN hotlink-only (Track B)
# Obtener en https://developers.brandfetch.com — 500k/m free
# Sin este ID, <CompanyLogo> cae inmediatamente a lettermark (sin request al CDN)
# NUNCA hacer fetch() al CDN desde el backend (bloqueo automated_traffic)
VITE_BRANDFETCH_CLIENT_ID=
