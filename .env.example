# === Cache — quotes-cache (Req7) ===
# Dragonfly (RESP3 drop-in Redis) — mapea 6380:6379 para no colisionar con 6379 local
CACHE_URL=redis://localhost:6380
# Si vacio -> degradado InMemory sin throw, boot no bloquea
CACHE_ENABLED=true
CACHE_TTL_QUOTES_MS=15000
CACHE_TTL_PANEL_MS=30000
CACHE_KEY_PREFIX=sentinel:quotes:v1

# === Brokers — multibroker-support ===
BROKER_IOL_ENABLED=true
BROKER_PPI_ENABLED=false
MARKET_DATA_PROVIDER_IOL=iol
MARKET_DATA_PROVIDER_PPI=byma
ENCRYPTION_KEY=change_me_32_chars_min
